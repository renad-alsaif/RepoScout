
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Free models with tool support. The fallback is used if the main model fails.
REPOSCOUT_MODEL=nvidia/nemotron-3.5-super-vl:free
REPOSCOUT_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Without it, GitHub tools use the offline data in fixtures/github/.
GITHUB_TOKEN=

# 0 = issues are only saved locally. 1 = really post (only to your own test repo).
REPOSCOUT_LIVE_WRITES=0